@app.get("/cep/{cep}", response_model=Endereco)
async def consultar_cep(cep: str):
    """Consulta um CEP específico."""
    try:
        cep_validado = validar_cep(cep)
        endereco = buscar_endereco(cep_validado)
        historico.adicionar(cep_validado, endereco)
        
        return Endereco(
            cep=endereco.get("cep"),
            logradouro=endereco.get("logradouro", ""),
            bairro=endereco.get("bairro", ""),
            localidade=endereco.get("localidade", ""),
            uf=endereco.get("uf", ""),
            complemento=endereco.get("complemento", "")
        )
    except ValueError as e:
        raise HTTPException(status_code=400, detail=str(e))
    except Exception as e:
        logger.error(f"Erro ao consultar CEP: {e}")
        raise HTTPException(status_code=500, detail="Erro interno do servidor")

@app.get("/cep/{cep}/mapa", response_model=EnderecoComCoordenadas)
async def consultar_cep_com_mapa(cep: str):
    """Consulta um CEP e retorna coordenadas para Google Maps e Uber."""
    try:
        cep_validado = validar_cep(cep)
        endereco = buscar_endereco(cep_validado)
        historico.adicionar(cep_validado, endereco)
        
        lat, lon = obter_coordenadas(endereco)
        urls = gerar_urls_integracao(endereco, lat, lon)
        
        return EnderecoComCoordenadas(
            cep=endereco.get("cep"),
            logradouro=endereco.get("logradouro", ""),
            bairro=endereco.get("bairro", ""),
            localidade=endereco.get("localidade", ""),
            uf=endereco.get("uf", ""),
            complemento=endereco.get("complemento", ""),
            latitude=lat,
            longitude=lon,
            url_google_maps=urls["url_google_maps"],
            url_uber=urls["url_uber"]
        )
    except ValueError as e:
        raise HTTPException(status_code=400, detail=str(e))
    except Exception as e:
        logger.error(f"Erro ao consultar CEP com mapa: {e}")
        raise HTTPException(status_code=500, detail="Erro interno do servidor")

@app.get("/cep/multiplo", response_model=RespostaMultiplosCeps)
async def consultar_multiplos_ceps(ceps: List[str] = Query(...)):
    """Consulta múltiplos CEPs."""
    if len(ceps) > MAX_MULTIPLOS_CEPS:
        raise HTTPException(
            status_code=400,
            detail=f"Máximo de {MAX_MULTIPLOS_CEPS} CEPs por requisição"
        )
    
    resultados = []
    erros = []
    
    for cep in ceps:
        try:
            cep_validado = validar_cep(cep)
            endereco = buscar_endereco(cep_validado)
            historico.adicionar(cep_validado, endereco)
            
            lat, lon = obter_coordenadas(endereco)
            urls = gerar_urls_integracao(endereco, lat, lon)
            
            resultado = EnderecoComCoordenadas(
                cep=endereco.get("cep"),
                logradouro=endereco.get("logradouro", ""),
                bairro=endereco.get("bairro", ""),
                localidade=endereco.get("localidade", ""),
                uf=endereco.get("uf", ""),
                complemento=endereco.get("complemento", ""),
                latitude=lat,
                longitude=lon,
                url_google_maps=urls["url_google_maps"],
                url_uber=urls["url_uber"]
            )
            resultados.append(resultado)
        
        except ValueError as e:
            erros.append({"cep": cep, "erro": str(e)})
        except Exception as e:
            erros.append({"cep": cep, "erro": "Erro inesperado"})
    
    return RespostaMultiplosCeps(
        total=len(ceps),
        sucesso=len(resultados),
        falhas=len(erros),
        resultados=resultados,
        erros=erros
    )

