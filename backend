# ==================== Modelos Pydantic ====================

class Endereco(BaseModel):
    """Modelo de endereço."""
    cep: str
    logradouro: str
    bairro: str
    localidade: str
    uf: str
    complemento: Optional[str] = ""

class EnderecoComCoordenadas(Endereco):
    """Modelo de endereço com coordenadas."""
    latitude: Optional[float] = None
    longitude: Optional[float] = None
    url_google_maps: Optional[str] = None
    url_uber: Optional[str] = None

class RegistroHistorico(BaseModel):
    """Modelo de registro do histórico."""
    cep: str
    data: str
    endereco: Dict

class RespostaMultiplosCeps(BaseModel):
    """Modelo de resposta para múltiplos CEPs."""
    total: int
    sucesso: int
    falhas: int
    resultados: List[EnderecoComCoordenadas]
    erros: List[Dict]

# ==================== Gerenciador de Histórico ====================

class GerenciadorHistorico:
    """Gerencia o histórico de buscas em arquivo JSON."""
    
    def __init__(self, arquivo: str = HISTORICO_FILE):
        self.arquivo = os.path.join(os.path.dirname(__file__), arquivo)
        self.dados = self._carregar()
    
    def _carregar(self) -> List[Dict]:
        """Carrega histórico do arquivo."""
        try:
            if os.path.exists(self.arquivo):
                with open(self.arquivo, 'r', encoding='utf-8') as f:
                    return json.load(f)
            return []
        except (json.JSONDecodeError, IOError) as e:
            logger.warning(f"Erro ao carregar histórico: {e}")
            return []
    
    def _salvar(self) -> None:
        """Salva histórico no arquivo."""
        try:
            with open(self.arquivo, 'w', encoding='utf-8') as f:
                json.dump(self.dados, f, indent=2, ensure_ascii=False)
        except IOError as e:
            logger.error(f"Erro ao salvar histórico: {e}")
    
    def adicionar(self, cep: str, endereco: dict) -> None:
        """Adiciona uma busca ao histórico."""
        entrada = {
            "cep": cep,
            "data": datetime.now().strftime("%d/%m/%Y %H:%M:%S"),
            "endereco": endereco
        }
        self.dados.append(entrada)
        # Manter apenas os últimos registros
        if len(self.dados) > LIMITE_HISTORICO:
            self.dados = self.dados[-LIMITE_HISTORICO:]
        self._salvar()
    
    def obter_todos(self, limite: int = 10) -> List[Dict]:
        """Retorna últimos N registros."""
        return self.dados[-limite:]
    
    def limpar(self) -> None:
        """Limpa o histórico."""
        self.dados = []
        self._salvar()

# Instância global do gerenciador
historico = GerenciadorHistorico()

# ==================== Funções Auxiliares ====================

def validar_cep(cep: str) -> str:
    """Valida e formata o CEP."""
    cep = cep.replace("-", "").replace(".", "").strip()
    
    if not cep:
        raise ValueError("CEP não pode estar vazio.")
    
    if len(cep) != 8:
        raise ValueError(f"CEP deve ter 8 dígitos. Recebido: {len(cep)}")
    
    if not cep.isdigit():
        raise ValueError("CEP deve conter apenas dígitos.")
    
    return cep

def buscar_endereco(cep: str) -> dict:
    """Busca o endereço do CEP na API ViaCEP."""
    try:
        url = CEP_API_URL.format(cep)
        response = requests.get(url, timeout=REQUEST_TIMEOUT)
        response.raise_for_status()
        
        dados = response.json()
        
        if dados.get("erro"):
            raise ValueError(f"CEP {cep} não encontrado no sistema.")
        
        return dados
    
    except requests.Timeout:
        raise ValueError("Timeout ao consultar a API. Tente novamente.")
    except requests.HTTPError as e:
        raise ValueError(f"Erro HTTP {e.response.status_code}: {e.response.reason}")
    except requests.ConnectionError:
        raise ValueError("Erro de conexão. Verifique sua internet.")
    except Exception as e:
        logger.error(f"Erro inesperado: {e}")
        raise ValueError(f"Erro inesperado: {e}")

def obter_coordenadas(endereco: dict) -> Tuple[Optional[float], Optional[float]]:
    """Obtém as coordenadas (latitude, longitude) do endereço com retry."""
    try:
        logradouro = endereco.get("logradouro", "").strip()
        localidade = endereco.get("localidade", "").strip()
        uf = endereco.get("uf", "").strip()
        
        if not logradouro or not localidade:
            logger.warning("Endereço incompleto para geolocalização")
            return None, None
        
        endereco_completo = f"{logradouro}, {localidade}, {uf}, Brasil"
        
        params = {
            "q": endereco_completo,
            "format": "json",
            "limit": 1,
            "timeout": REQUEST_TIMEOUT,
            "accept-language": "pt-BR"
        }
        
        for tentativa in range(MAX_RETRIES):
            try:
                response = requests.get(
                    GEOCODE_API_URL,
                    params=params,
                    timeout=REQUEST_TIMEOUT,
                    headers={"User-Agent": "Consulta-CEP-API/1.0"}
                )
                response.raise_for_status()
                
                dados = response.json()
                
                if not dados:
                    return None, None
                
                if not isinstance(dados[0], dict):
                    return None, None
                
                try:
                    lat = float(dados[0].get("lat"))
                    lon = float(dados[0].get("lon"))
                except (ValueError, TypeError):
                    return None, None
                
                if not (-90 <= lat <= 90) or not (-180 <= lon <= 180):
                    return None, None
                
                return lat, lon
            
            except (requests.Timeout, requests.ConnectionError):
                if tentativa < MAX_RETRIES - 1:
                    time.sleep(RETRY_DELAY * (tentativa + 1))
                else:
                    return None, None
            except requests.HTTPError as e:
                if e.response.status_code == 429 and tentativa < MAX_RETRIES - 1:
                    espera = RETRY_DELAY * (2 ** tentativa)
                    time.sleep(espera)
                else:
                    return None, None
    
    except Exception as e:
        logger.error(f"Erro ao obter coordenadas: {e}")
        return None, None

def gerar_urls_integracao(endereco: dict, lat: Optional[float], lon: Optional[float]) -> dict:
    """Gera URLs de integração com Google Maps e Uber."""
    urls = {
        "url_google_maps": None,
        "url_uber": None
    }
    
    if lat is not None and lon is not None:
        logradouro = endereco.get("logradouro", "Localização").replace(" ", "+")
        urls["url_google_maps"] = f"https://www.google.com/maps/search/{logradouro}/@{lat},{lon},18z"
        urls["url_uber"] = f"https://m.uber.com/?action=setPickupLocation&pickup[latitude]={lat}&pickup[longitude]={lon}"
    
    return urls

